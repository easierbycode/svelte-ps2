{
  "name": "5velte-ps2",
  "version": "1.0.0",
  "description": "Svelte 5 era AthenaEnv v4 (PS2) compatibility layer — run AthenaEnv-style code on Phaser 4 in the browser, and port code between Phaser and the PS2",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/easierbycode/svelte-ps2.git"
  },
  "files": [
    "src",
    "jsr.json",
    "LICENSE"
  ],
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    },
    "./phaser": {
      "types": "./src/phaser/index.ts",
      "default": "./src/phaser/index.ts"
    }
  },
  "peerDependencies": {
    "phaser": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "phaser": {
      "optional": true
    }
  }
}
